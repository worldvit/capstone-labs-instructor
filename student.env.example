# ============================================================
# student.env.example — 이 파일을 student.env 로 복사해 채우십시오.
#
#   cp student.env.example student.env
#   vi student.env
#   source student.env
#
# CloudShell 을 다시 열어도 유지되게 하려면:
#   echo '[ -f ~/capstone-labs-instructor/student.env ] && . ~/capstone-labs-instructor/student.env' >> ~/.bashrc
# ============================================================

# ---------- 필수 ----------
# 본인 AWS 계정번호 12자리. 아래 명령으로 확인합니다.
#   aws sts get-caller-identity --query Account --output text
#
# 이 값이 비어 있으면 실행이 중단됩니다.
# 엉뚱한 계정에 실습 리소스를 만드는 사고를 막기 위한 장치입니다.
export EXPECTED_ACCOUNT_IDS=

# ---------- 기본값 그대로 두어도 됩니다 ----------
export REGION=ap-northeast-2

# 리소스 이름 접두사. 계정이 각자 있으므로 바꿀 필요가 없습니다.
export PREFIX=cap

# VPC 대역 기준값. 계정이 각자 있으므로 바꿀 필요가 없습니다.
#   1  -> svc 10.1.0.0/16, mgmt 10.2.0.0/16
export STUDENT_BASE=1

# ---------- 선택 ----------
# 리소스 ID 를 S3 에 백업해 다른 PC 에서 이어하려면 채우십시오.
# 비워두면 로컬 state 파일만 씁니다.
export STATE_SYNC=0
export STATE_BUCKET=

# ============================================================
# 참고 — build.sh 는 언제 쓰는가
#
# 이 저장소에는 각 랩의 build.sh 가 들어 있습니다.
# 콘솔로 직접 만들지 않고 한 번에 만들어 주는 스크립트입니다.
#
#   bash build-all.sh 1      # Lab 1 까지
#   bash build-all.sh 3      # Lab 1~3
#   bash build-all.sh --list # 랩 번호 확인
#
# 이것은 결석 등으로 진도를 맞춰야 할 때 쓰는 도구입니다.
# 평소에는 실습 문서를 보며 콘솔로 직접 만드십시오.
# 콘솔에서 막히고 원인을 찾는 과정이 이 과정의 핵심입니다.
# ============================================================
